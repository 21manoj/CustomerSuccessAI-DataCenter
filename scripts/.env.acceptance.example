# Copy to scripts/.env.acceptance and source before run_acceptance_ec2.sh
#   cp scripts/.env.acceptance.example scripts/.env.acceptance

# --- HTTP acceptance (runs from laptop against live host) ---
CS_PULSE_BASE_URL=http://3.94.106.197
CS_PULSE_EMAIL=dc2s_super@test.com
CS_PULSE_PASSWORD=DC2_Super_2024!
ACCEPTANCE_CUSTOMER_ID=334

# --- Persona grading (runs inside platform container) ---
# Required when ACCEPTANCE_RUN_PERSONA=1
ANTHROPIC_API_KEY=sk-ant-...

# Docker container name or ID on EC2 (auto-detect if empty)
# CSPULSE_CONTAINER=cspulse-platform-1

# Persona options
ACCEPTANCE_PERSONA_SHOTS=3
ACCEPTANCE_PERSONAS=cro,cfo,vpcs
# Minimum blended numeric grade (3.7 = A-). Set 0 to only run, not gate.
ACCEPTANCE_MIN_GRADE_NUMERIC=0

# Optional: seed demo data on tenant before checks
# ACCEPTANCE_SEED_VPCS=1
