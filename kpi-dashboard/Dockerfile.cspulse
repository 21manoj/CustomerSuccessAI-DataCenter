# ================================================================
# CS Pulse Platform — Multi-Stage Docker Build
# Produces a Cython-compiled Flask backend + React frontend + Nginx
#
# Build (from project root):
#   docker build -t cspulse-platform -f kpi-dashboard/Dockerfile.cspulse .
# Build (from kpi-dashboard dir):
#   docker build -t cspulse-platform -f Dockerfile.cspulse ..
# Run:
#   docker run -p 80:80 -p 5059:5059 --env-file .env cspulse-platform
# ================================================================

# ================================================================
# Stage 1: Build React Frontend
# ================================================================
FROM node:18-alpine AS frontend-builder

WORKDIR /app

# Install dependencies (cached layer)
COPY kpi-dashboard/package*.json ./
RUN npm ci --production=false

# Copy frontend source and build
COPY kpi-dashboard/src/ ./src/
COPY kpi-dashboard/public/ ./public/
COPY kpi-dashboard/tsconfig.json ./
COPY kpi-dashboard/tailwind.config.js ./
COPY kpi-dashboard/postcss.config.js ./

RUN npm run build


# ================================================================
# Stage 2: Cython Compilation of Backend
# ================================================================
FROM python:3.11-slim AS backend-builder

WORKDIR /app

# Install build dependencies (gcc for Cython, pg headers for psycopg2)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    python3-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python production deps + Cython
COPY kpi-dashboard/backend/requirements-core.txt ./requirements-core.txt
RUN pip install --no-cache-dir -r requirements-core.txt
RUN pip install --no-cache-dir Cython>=3.0.0

# Copy backend source (filtered by .dockerignore)
COPY kpi-dashboard/backend/ ./

# Compile Python → C → .so shared objects
RUN python setup_cython.py build_ext --inplace 2>&1 | tail -5

# Remove .py source ONLY from dirs that are never imported at runtime.
# KEEP: agents/, verticals/, mcp_server/ — all excluded from Cython but imported at runtime.
# KEEP: scripts/generate_synthetic_*.py — needed at runtime for demo-mode onboarding
RUN for dir in migrations templates; do \
      find "./$dir" -name "*.py" -delete 2>/dev/null || true; \
    done && \
    find ./scripts -name "*.py" ! -name "generate_synthetic_*.py" -delete 2>/dev/null || true

# Clean up build artifacts
RUN rm -rf build/ *.egg-info/ setup_cython.py
RUN find . -name "*.c" -delete
RUN find . -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true


# ================================================================
# Stage 2b: Prepare Load Driver (lightweight copy, no Cython)
# ================================================================
FROM python:3.11-slim AS loaddriver-prep

WORKDIR /app/load-driver

# Copy load-driver source
COPY load-driver/ ./

# Remove test results, __pycache__, .pyc files (keep only runtime code)
RUN find . -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true && \
    find . -name "*.pyc" -delete 2>/dev/null || true && \
    rm -rf results/ *-test_results.md .dockerignore Dockerfile


# ================================================================
# Stage 3: Production Runtime (Slim)
# ================================================================
FROM python:3.11-slim AS runtime

WORKDIR /app

# Install minimal runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx \
    curl \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Copy Python packages from builder (no gcc/g++ needed at runtime)
COPY --from=backend-builder /usr/local/lib/python3.11/site-packages \
     /usr/local/lib/python3.11/site-packages
COPY --from=backend-builder /usr/local/bin/gunicorn /usr/local/bin/gunicorn
COPY --from=backend-builder /usr/local/bin/flask /usr/local/bin/flask

# Copy compiled backend (.so files + essential .py)
COPY --from=backend-builder /app /app/backend

# Copy load-driver (for Test Runner UI)
COPY --from=loaddriver-prep /app/load-driver /app/load-driver

# Install load-driver-only dependencies (faker, click, tabulate, tqdm — rest already in backend)
RUN pip install --no-cache-dir faker>=22.0.0 click>=8.1.0 tabulate>=0.9.0 tqdm>=4.66.0

# Copy React build to nginx serve directory
COPY --from=frontend-builder /app/build /usr/share/nginx/html

# Copy nginx config
COPY kpi-dashboard/nginx-cspulse.conf /etc/nginx/conf.d/default.conf
# Remove default nginx site
RUN rm -f /etc/nginx/sites-enabled/default

# Copy entrypoint script
COPY kpi-dashboard/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Create necessary directories
RUN mkdir -p /app/backend/uploads /app/backend/instance /app/backend/verticals \
             /app/load-driver/results/ui-runs

# Environment defaults
ENV FLASK_APP=app_v3_minimal.py
ENV FLASK_ENV=production
ENV PYTHONPATH=/app/backend
ENV PYTHONUNBUFFERED=1
ENV GUNICORN_WORKERS=4
ENV GUNICORN_TIMEOUT=120
ENV LOAD_DRIVER_DIR=/app/load-driver

# Expose ports (80=Nginx, 5059=Flask, 8001=MCP HTTP/SSE)
EXPOSE 80 5059 8001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:5059/api/health || exit 1

ENTRYPOINT ["/docker-entrypoint.sh"]
