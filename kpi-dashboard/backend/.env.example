# CS Pulse Backend — example environment variables
# Copy to .env and fill in values. Never commit .env or real keys to git.
# For production (Docker/AWS), set these via runtime env or secrets manager only.

# Required: PostgreSQL connection (use at runtime; not baked into images)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Required in production: Flask session secret (min 32 chars)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=your-secret-key-here-minimum-32-characters

# API keys (provide at runtime in production)
# OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: encryption for n8n credentials / webhooks
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=your-fernet-key-here

# Optional: debug (set to true only in development; never in production)
# FLASK_DEBUG=false
# FLASK_ENV=development

# Session cookie Secure flag.
#   true  (default for production): cookie only sent over HTTPS.
#   false: required when terminating HTTP directly on EC2 (no HTTPS termination
#          at the platform container — e.g., direct-IP demo access). Set this
#          to false in ~/cspulse/.env on the demo EC2 host, otherwise the
#          browser drops the session cookie on /login responses and every
#          subsequent /api/* call returns 401.
#          CloudFront in front of EC2 already does HTTPS termination at the
#          edge, so cookies still flow secure-end-to-end for visitors who use
#          the CloudFront URL even when SESSION_COOKIE_SECURE=false in the
#          platform container.
# SESSION_COOKIE_SECURE=false

# Optional: Qdrant (use Qdrant Cloud in production)
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=your-qdrant-api-key
