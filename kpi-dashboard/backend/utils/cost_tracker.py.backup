"""
Cost Tracking Module for Signal Analyst
Tracks and logs all API costs (OpenAI + Anthropic)
"""

import time
from datetime import datetime, timedelta
from decimal import Decimal
from typing import Optional, Dict, List
from sqlalchemy import create_engine, text
from contextlib import contextmanager
import logging

logger = logging.getLogger(__name__)


# =============================================================================
# PRICING (as of January 2025)
# =============================================================================

PRICING = {
    'openai': {
        'text-embedding-3-small': {
            'input': 0.00002 / 1000,  # $0.02 per 1M tokens
        },
        'text-embedding-3-large': {
            'input': 0.00013 / 1000,  # $0.13 per 1M tokens
        },
    },
    'anthropic': {
        'claude-sonnet-4-20250514': {
            'input': 0.003 / 1000,   # $3 per 1M tokens
            'output': 0.015 / 1000,  # $15 per 1M tokens
        },
        'claude-opus-4-20250514': {
            'input': 0.015 / 1000,   # $15 per 1M tokens
            'output': 0.075 / 1000,  # $75 per 1M tokens
        },
    }
}


# =============================================================================
# COST CALCULATOR
# =============================================================================

class CostCalculator:
    """Calculate API costs based on usage"""
    
    @staticmethod
    def calculate_openai_cost(model: str, tokens: int) -> float:
        """
        Calculate OpenAI API cost
        
        Args:
            model: Model name (e.g., 'text-embedding-3-large')
            tokens: Number of tokens used
        
        Returns:
            Cost in USD
        """
        if model not in PRICING['openai']:
            logger.warning(f"Unknown OpenAI model: {model}, using default pricing")
            return tokens * 0.0001 / 1000  # Default conservative estimate
        
        price_per_token = PRICING['openai'][model]['input']
        return tokens * price_per_token
    
    @staticmethod
    def calculate_claude_cost(model: str, input_tokens: int, output_tokens: int) -> float:
        """
        Calculate Claude API cost
        
        Args:
            model: Model name (e.g., 'claude-sonnet-4-20250514')
            input_tokens: Input tokens
            output_tokens: Output tokens
        
        Returns:
            Cost in USD
        """
        if model not in PRICING['anthropic']:
            logger.warning(f"Unknown Claude model: {model}, using default pricing")
            input_cost = input_tokens * 0.003 / 1000
            output_cost = output_tokens * 0.015 / 1000
            return input_cost + output_cost
        
        pricing = PRICING['anthropic'][model]
        input_cost = input_tokens * pricing['input']
        output_cost = output_tokens * pricing['output']
        
        return input_cost + output_cost


# =============================================================================
# COST TRACKER
# =============================================================================

class CostTracker:
    """
    Track and log API costs to database
    
    Usage:
        tracker = CostTracker(db_engine)
        
        with tracker.track_openai_call('text-embedding-3-large', customer_id=1):
            response = openai.embeddings.create(...)
            tracker.record_tokens(response.usage.total_tokens)
    """
    
    def __init__(self, db_engine):
        self.db_engine = db_engine
        self.calculator = CostCalculator()
    
    def log_api_call(self, provider: str, model: str, call_type: str,
                     tokens_input: int, tokens_output: int,
                     cost: float, success: bool = True,
                     error_message: Optional[str] = None,
                     execution_time_ms: Optional[int] = None,
                     customer_id: Optional[int] = None,
                     account_id: Optional[int] = None):
        """
        Log API call to database
        
        Args:
            provider: 'openai' or 'anthropic'
            model: Model name
            call_type: 'embedding', 'claude_analysis', 'vector_search'
            tokens_input: Input tokens
            tokens_output: Output tokens
            cost: Calculated cost
            success: Whether call succeeded
            error_message: Error message if failed
            execution_time_ms: Execution time in milliseconds
            customer_id: Customer ID
            account_id: Account ID being analyzed
        """
        try:
            with self.db_engine.connect() as conn:
                conn.execute(text("""
                    INSERT INTO api_usage_log (
                        timestamp, customer_id, account_id, call_type,
                        provider, model, tokens_input, tokens_output, tokens_total,
                        cost, success, error_message, execution_time_ms
                    ) VALUES (
                        NOW(), :customer_id, :account_id, :call_type,
                        :provider, :model, :tokens_input, :tokens_output, :tokens_total,
                        :cost, :success, :error_message, :execution_time_ms
                    )
                """), {
                    'customer_id': customer_id,
                    'account_id': account_id,
                    'call_type': call_type,
                    'provider': provider,
                    'model': model,
                    'tokens_input': tokens_input,
                    'tokens_output': tokens_output,
                    'tokens_total': tokens_input + tokens_output,
                    'cost': cost,
                    'success': success,
                    'error_message': error_message,
                    'execution_time_ms': execution_time_ms
                })
                conn.commit()
        
        except Exception as e:
            logger.error(f"Failed to log API usage: {e}")
    
    @contextmanager
    def track_openai_call(self, model: str, call_type: str = 'embedding',
                          customer_id: Optional[int] = None,
                          account_id: Optional[int] = None):
        """
        Context manager to track OpenAI API call
        
        Usage:
            with tracker.track_openai_call('text-embedding-3-large', customer_id=1):
                response = openai.embeddings.create(...)
                tracker.record_tokens(response.usage.total_tokens)
        """
        start_time = time.time()
        tokens = 0
        error_msg = None
        success = True
        
        class TokenRecorder:
            def record_tokens(self, token_count):
                nonlocal tokens
                tokens = token_count
        
        recorder = TokenRecorder()
        
        try:
            yield recorder
        except Exception as e:
            success = False
            error_msg = str(e)
            raise
        finally:
            execution_time_ms = int((time.time() - start_time) * 1000)
            cost = self.calculator.calculate_openai_cost(model, tokens)
            
            self.log_api_call(
                provider='openai',
                model=model,
                call_type=call_type,
                tokens_input=tokens,
                tokens_output=0,
                cost=cost,
                success=success,
                error_message=error_msg,
                execution_time_ms=execution_time_ms,
                customer_id=customer_id,
                account_id=account_id
            )
    
    @contextmanager
    def track_claude_call(self, model: str, call_type: str = 'claude_analysis',
                          customer_id: Optional[int] = None,
                          account_id: Optional[int] = None):
        """
        Context manager to track Claude API call
        
        Usage:
            with tracker.track_claude_call('claude-sonnet-4', customer_id=1):
                response = claude.messages.create(...)
                tracker.record_usage(response.usage.input_tokens, response.usage.output_tokens)
        """
        start_time = time.time()
        input_tokens = 0
        output_tokens = 0
        error_msg = None
        success = True
        
        class UsageRecorder:
            def record_usage(self, inp_tokens, out_tokens):
                nonlocal input_tokens, output_tokens
                input_tokens = inp_tokens
                output_tokens = out_tokens
        
        recorder = UsageRecorder()
        
        try:
            yield recorder
        except Exception as e:
            success = False
            error_msg = str(e)
            raise
        finally:
            execution_time_ms = int((time.time() - start_time) * 1000)
            cost = self.calculator.calculate_claude_cost(model, input_tokens, output_tokens)
            
            self.log_api_call(
                provider='anthropic',
                model=model,
                call_type=call_type,
                tokens_input=input_tokens,
                tokens_output=output_tokens,
                cost=cost,
                success=success,
                error_message=error_msg,
                execution_time_ms=execution_time_ms,
                customer_id=customer_id,
                account_id=account_id
            )


# =============================================================================
# COST REPORTING
# =============================================================================

class CostReporter:
    """Generate cost reports from api_usage_log"""
    
    def __init__(self, db_engine):
        self.db_engine = db_engine
    
    def get_daily_costs(self, date: Optional[datetime] = None) -> Dict:
        """
        Get costs for a specific day
        
        Args:
            date: Date to query (default: today)
        
        Returns:
            Dictionary with cost breakdown
        """
        if date is None:
            date = datetime.now()
        
        with self.db_engine.connect() as conn:
            result = conn.execute(text("""
                SELECT 
                    provider,
                    call_type,
                    COUNT(*) as call_count,
                    SUM(tokens_total) as total_tokens,
                    SUM(cost) as total_cost,
                    AVG(execution_time_ms) as avg_execution_time_ms,
                    SUM(CASE WHEN success THEN 1 ELSE 0 END) as successful_calls,
                    SUM(CASE WHEN NOT success THEN 1 ELSE 0 END) as failed_calls
                FROM api_usage_log
                WHERE DATE(timestamp) = :date
                GROUP BY provider, call_type
                ORDER BY total_cost DESC
            """), {'date': date.date()})
            
            breakdown = []
            total_cost = 0
            
            for row in result:
                item = {
                    'provider': row.provider,
                    'call_type': row.call_type,
                    'call_count': row.call_count,
                    'total_tokens': row.total_tokens,
                    'total_cost': float(row.total_cost),
                    'avg_execution_time_ms': float(row.avg_execution_time_ms) if row.avg_execution_time_ms else 0,
                    'success_rate': (row.successful_calls / row.call_count * 100) if row.call_count > 0 else 0
                }
                breakdown.append(item)
                total_cost += item['total_cost']
            
            return {
                'date': date.date().isoformat(),
                'total_cost': total_cost,
                'breakdown': breakdown
            }
    
    def get_monthly_costs(self, year: int, month: int) -> Dict:
        """Get costs for a specific month"""
        with self.db_engine.connect() as conn:
            result = conn.execute(text("""
                SELECT 
                    DATE(timestamp) as date,
                    SUM(cost) as daily_cost,
                    COUNT(*) as call_count
                FROM api_usage_log
                WHERE EXTRACT(YEAR FROM timestamp) = :year
                  AND EXTRACT(MONTH FROM timestamp) = :month
                GROUP BY DATE(timestamp)
                ORDER BY date
            """), {'year': year, 'month': month})
            
            daily_costs = []
            total_cost = 0
            
            for row in result:
                daily_costs.append({
                    'date': row.date.isoformat(),
                    'cost': float(row.daily_cost),
                    'call_count': row.call_count
                })
                total_cost += float(row.daily_cost)
            
            return {
                'year': year,
                'month': month,
                'total_cost': total_cost,
                'daily_costs': daily_costs
            }
    
    def get_customer_costs(self, customer_id: int, days: int = 30) -> Dict:
        """Get costs for a specific customer"""
        with self.db_engine.connect() as conn:
            result = conn.execute(text("""
                SELECT 
                    call_type,
                    COUNT(*) as call_count,
                    SUM(cost) as total_cost
                FROM api_usage_log
                WHERE customer_id = :customer_id
                  AND timestamp >= NOW() - INTERVAL ':days days'
                GROUP BY call_type
                ORDER BY total_cost DESC
            """), {'customer_id': customer_id, 'days': days})
            
            breakdown = []
            total_cost = 0
            
            for row in result:
                item = {
                    'call_type': row.call_type,
                    'call_count': row.call_count,
                    'total_cost': float(row.total_cost)
                }
                breakdown.append(item)
                total_cost += item['total_cost']
            
            return {
                'customer_id': customer_id,
                'period_days': days,
                'total_cost': total_cost,
                'breakdown': breakdown
            }


# =============================================================================
# EXAMPLE USAGE
# =============================================================================

if __name__ == "__main__":
    import os
    from dotenv import load_dotenv
    
    load_dotenv()
    engine = create_engine(os.getenv("DATABASE_URL"))
    
    # Initialize tracker
    tracker = CostTracker(engine)
    
    # Example: Track OpenAI embedding
    with tracker.track_openai_call('text-embedding-3-large', customer_id=1, account_id=1007) as recorder:
        # Simulate API call
        tokens_used = 150
        recorder.record_tokens(tokens_used)
    
    # Example: Track Claude analysis
    with tracker.track_claude_call('claude-sonnet-4-20250514', customer_id=1, account_id=1007) as recorder:
        # Simulate API call
        input_tokens = 487
        output_tokens = 312
        recorder.record_usage(input_tokens, output_tokens)
    
    # Get reports
    reporter = CostReporter(engine)
    
    daily_report = reporter.get_daily_costs()
    print("Daily Costs:", daily_report)
    
    monthly_report = reporter.get_monthly_costs(2025, 1)
    print("Monthly Costs:", monthly_report)
