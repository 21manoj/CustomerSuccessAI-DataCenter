@step("2. Provision Customer Directory (via API)")
def test_provision_directory(customer_id: int) -> Path:
    """Step 2: Provision directory using /api/onboarding/provision"""
    log(f"Provisioning directory for customer {customer_id}...")
    
    response = requests.post(
        f"{BASE_URL}/api/onboarding/provision",
        json={"customer_id": customer_id},
        timeout=30
    )
    
    if response.status_code != 200:
        raise Exception(f"Provisioning failed: {response.text}")
    
    result = response.json()
    log(f"✅ Directory provisioned")
    log(f"   Path: {result.get('customer_dir')}")
    
    # Get directory path
    customer_dir = get_customer_directory(customer_id)
    
    # Validate directory structure
    required_dirs = ['data', 'scripts', 'journey']
    for dir_name in required_dirs:
        dir_path = customer_dir / dir_name
        log_validation(
            f"Subdirectory '{dir_name}' Exists",
            dir_path.exists(),
            f"Subdirectory {dir_name} should exist",
            "Exists",
            str(dir_path.exists())
        )
    
    return customer_dir

# ============================================================================
# Step 3: Generate and Upload Files
# ============================================================================

@step("3. Generate and Upload Sample Files")
def test_generate_and_upload_files(customer_id: int, customer_dir: Path) -> Dict:
    """Step 3: Generate synthetic data and save to customer directory"""
    log(f"Generating synthetic data for customer {customer_id}...")
    
    num_accounts = 10  # Updated to 10 accounts as requested
    num_months = 12
    
    # Generate data using fixed generator
    accounts = synth_gen.generate_accounts(
        customer_id=customer_id,
        num_accounts=num_accounts,
        industry='Technology',
        company_name=TEST_COMPANY_NAME
    )
    
    kpi_measurements = synth_gen.generate_kpi_measurements(accounts)
    qualitative_signals = synth_gen.generate_qualitative_signals(accounts)
    products = synth_gen.generate_products(customer_id=customer_id)
    customers = synth_gen.generate_customers_csv(
        customer_id=customer_id,
        company_name=TEST_COMPANY_NAME,
        industry='Technology'
    )
    
    # Save to CSV files
    data_dir = customer_dir / 'data'
    data_dir.mkdir(exist_ok=True)
    
    files_created = {}
    
    # Save accounts
    accounts_df = pd.DataFrame(accounts)
    
    # DEBUG: Check accounts data structure
    log("\nDEBUG: Checking accounts data structure")
    log(f"First account keys: {list(accounts[0].keys())}")
    
    # Check if _scenario was removed
    if '_scenario' in accounts[0]:
        log("❌ WARNING: _scenario still in data!")
    else:
        log("✅ _scenario removed")
    
    # Check required columns are present
    required = ['account_id', 'account_name', 'customer_id', 'industry', 'region']
    missing = [col for col in required if col not in accounts[0]]
    if missing:
        log(f"❌ MISSING COLUMNS: {missing}")
    else:
        log("✅ All required columns present")
    
    # Ensure customer_id column exists and is correct
    if 'customer_id' not in accounts_df.columns:
        accounts_df['customer_id'] = customer_id
    accounts_df['customer_id'] = customer_id
    
    # Remove internal columns that aren't in the database schema
    # These are used for data generation but shouldn't be in the CSV
    columns_to_drop = ['_scenario', '_scenario_key']
    for col in columns_to_drop:
        if col in accounts_df.columns:
            accounts_df = accounts_df.drop(columns=[col])
            log(f"   Removed column: {col}")
    
    # Convert profile_metadata from dict to JSON string if needed
    if 'profile_metadata' in accounts_df.columns:
        accounts_df['profile_metadata'] = accounts_df['profile_metadata'].apply(
            lambda x: json.dumps(x) if isinstance(x, dict) else x
        )
        log("   Converted profile_metadata to JSON string")
    
    # DEBUG: Show final columns
    log(f"Final CSV columns: {list(accounts_df.columns)}")
    
    accounts_file = data_dir / 'accounts.csv'
    accounts_df.to_csv(accounts_file, index=False)
    files_created['accounts'] = accounts_file
    log(f"   ✅ Saved {len(accounts)} accounts to {accounts_file}")
    
    # DEBUG: Verify CSV file was created correctly
    log("\nDEBUG: Verifying CSV file")
    if accounts_file.exists():
        # Read back the CSV to verify
        verify_df = pd.read_csv(accounts_file)
        log(f"  CSV file exists: {accounts_file}")
        log(f"  CSV rows: {len(verify_df)}")
        log(f"  CSV columns: {list(verify_df.columns)}")
        log(f"  CSV columns count: {len(verify_df.columns)}")
        
        # Check for required NOT NULL columns
        required_not_null = ['account_id', 'customer_id', 'account_name']
        missing_required = [col for col in required_not_null if col not in verify_df.columns]
        if missing_required:
            log(f"  ❌ MISSING REQUIRED COLUMNS: {missing_required}")
        else:
            log(f"  ✅ All required columns present: {required_not_null}")
        
        # Show first row sample
        if len(verify_df) > 0:
            first_row = verify_df.iloc[0]
            log(f"  First row sample:")
            log(f"    account_id: {first_row.get('account_id', 'MISSING')}")
            log(f"    customer_id: {first_row.get('customer_id', 'MISSING')}")
            log(f"    account_name: {first_row.get('account_name', 'MISSING')[:50]}...")
    else:
        log(f"  ❌ CSV file NOT FOUND: {accounts_file}")
    
    # Save KPI measurements
    kpi_df = pd.DataFrame(kpi_measurements)
    kpi_file = data_dir / 'kpi_measurements.csv'
    kpi_df.to_csv(kpi_file, index=False)
    files_created['kpi_measurements'] = kpi_file
    log(f"   ✅ Saved {len(kpi_measurements)} KPI measurements to {kpi_file}")
    
    # Save qualitative signals
    signals_df = pd.DataFrame(qualitative_signals)
    signals_file = data_dir / 'qualitative_signals.csv'
    signals_df.to_csv(signals_file, index=False)
    files_created['qualitative_signals'] = signals_file
    log(f"   ✅ Saved {len(qualitative_signals)} qualitative signals to {signals_file}")
    
    # Save products
    products_df = pd.DataFrame(products)
    products_file = data_dir / 'products.csv'
    products_df.to_csv(products_file, index=False)
    files_created['products'] = products_file
    log(f"   ✅ Saved {len(products)} products to {products_file}")
    
    # Save customers
    customers_df = pd.DataFrame(customers)
    customers_file = data_dir / 'customers.csv'
    customers_df.to_csv(customers_file, index=False)
    files_created['customers'] = customers_file
    log(f"   ✅ Saved {len(customers)} customer records to {customers_file}")
    
    # Validate all files exist
    for file_type, file_path in files_created.items():
        log_validation(
            f"CSV File Created: {file_type}",
            file_path.exists(),
            f"File {file_path.name} should exist",
            "File exists",
            str(file_path.exists())
        )
    
    return {
        'accounts': accounts,
        'kpi_measurements': kpi_measurements,
        'qualitative_signals': qualitative_signals,
        'products': products,
        'files_created': files_created
    }

# ============================================================================
# Step 4: Process Data
# ============================================================================

@step("4. Process Data (Load + Embeddings + Wizard A via API)")
def test_process_data_api(customer_id: int, customer_dir: Path) -> Dict:
    """Step 4: Process data using /api/onboarding/process-data"""
    log(f"Processing data for customer {customer_id}...")
    log(f"  This will:")
    log(f"  1. Load CSV data into PostgreSQL")
    log(f"  2. Create embeddings in Qdrant")
    log(f"  3. Run Wizard A (journey generation)")
    
    response = requests.post(
        f"{BASE_URL}/api/onboarding/process-data",
        json={"customer_id": customer_id},
        timeout=300  # 5 minutes for data processing
    )
    
    if response.status_code != 200:
        raise Exception(f"Data processing failed: {response.text}")
    
    result = response.json()
    steps_completed = result.get('steps_completed', [])
    
    log(f"✅ Data processing completed")
    log(f"   Steps completed: {', '.join(steps_completed)}")
    
    # Validate journey files created
    wizard_a_dir = customer_dir / "journey" / "wizard_a"
    outputs_dir = wizard_a_dir / "outputs"
    journey_files = list(outputs_dir.glob("account_*_journey.json")) if outputs_dir.exists() else []
    
    log_validation(
        "Journey Files Generated",
        len(journey_files) > 0,
        f"Should have journey JSON files after Wizard A in {outputs_dir}",
        "> 0 files",
        f"{len(journey_files)} files"
    )
    
    if len(journey_files) > 0:
        log(f"  Found journey files: {[f.name for f in journey_files[:5]]}")
    
    # Validate journey_generation in steps_completed
    log_validation(
        "Journey Generation Step Completed",
        "journey_generation" in steps_completed,
        "journey_generation should be in steps_completed",
        "journey_generation in steps_completed",
        str("journey_generation" in steps_completed)
    )
    
    return {
        'steps_completed': steps_completed,
        'journey_files': journey_files
    }

# ============================================================================
# Step 5: Validate Final State
# ============================================================================

@step("5. Validate Final State (Database & Files)")
def test_validate_final_state(customer_id: int, customer_dir: Path):
    """Validate final state after all steps"""
    with app.app_context():
        log(f"Validating final state for customer {customer_id}")
        
        # Validate customer in database
        customer = Customer.query.filter_by(customer_id=customer_id).first()
        log_validation(
            "Customer in Database",
            customer is not None,
            f"Customer {customer_id} should exist in database",
            "Not None",
            "Found" if customer else "Not Found"
        )
        
        # Validate user
        user = User.query.filter_by(customer_id=customer_id).first()
        log_validation(
            "User in Database",
            user is not None,
            f"User for customer {customer_id} should exist",
            "Not None",
            "Found" if user else "Not Found"
        )
        
        # Validate config
        config = CustomerConfig.query.filter_by(customer_id=customer_id).first()
        log_validation(
            "Config in Database",
            config is not None,
            f"Config for customer {customer_id} should exist",
            "Not None",
            "Found" if config else "Not Found"
        )
        
        # Validate accounts
        accounts = Account.query.filter_by(customer_id=customer_id).all()
        account_count = len(accounts)
        log_validation(
            "Accounts in Database",
            account_count > 0,
            f"Should have accounts in database",
            "> 0",
            f"{account_count}"
        )
        
        # Validate KPI measurements
        if account_count > 0:
            account_ids = [a.account_id for a in accounts]
            result = db.session.execute(text('''
                SELECT COUNT(*) FROM kpi_measurements 
                WHERE account_id = ANY(:account_ids)
            '''), {'account_ids': account_ids})
            kpi_count = result.scalar()
            
            log_validation(
                "KPI Measurements in Database",
                kpi_count > 0,
                f"Should have KPI measurements loaded",
                "> 0",
                f"{kpi_count}"
            )
            
            # Validate qualitative signals
            result = db.session.execute(text('''
                SELECT COUNT(*) FROM qualitative_signals 
                WHERE account_id = ANY(:account_ids)
            '''), {'account_ids': account_ids})
            signal_count = result.scalar()
            
            log_validation(
                "Qualitative Signals in Database",
                signal_count > 0,
                f"Should have qualitative signals loaded",
                "> 0",
                f"{signal_count}"
            )
        
        # Validate directory structure
        log_validation(
            "Customer Directory Exists",
            customer_dir.exists(),
            f"Customer directory should exist",
            "True",
            str(customer_dir.exists())
        )
        
        # Validate journey data files
        wizard_a_dir = customer_dir / "journey" / "wizard_a"
        outputs_dir = wizard_a_dir / "outputs"
        journey_files = list(outputs_dir.glob("account_*_journey.json")) if outputs_dir.exists() else []
        log_validation(
            "Journey Data Files Exist",
            len(journey_files) > 0,
            f"Should have journey JSON files in {outputs_dir}",
            "> 0 files",
            f"{len(journey_files)} files"
        )

# ============================================================================
# NEW STEP 6: Validate Journey API Endpoints
# ============================================================================

@step("6. Validate Journey API Endpoints (CRITICAL)")
def test_validate_journey_api(customer_id: int, accounts: List[Dict]) -> Dict:
    """
    NEW IN V2: Validate that journey API endpoints actually work!
    
    This is the CRITICAL validation that was missing in V1.
    Tests that the dynamic journey API can serve the generated data.
    """
    log(f"Validating journey API for customer {customer_id}...")
    log(f"This validates that the dynamic journey API endpoint works for all accounts")
    
    # Authenticate session for API calls
    session = requests.Session()
    authenticated = False
    try:
        # Try to authenticate with the test user credentials
        login_response = session.post(
            f"{BASE_URL}/api/login",
            json={'email': TEST_EMAIL, 'password': TEST_PASSWORD},
            timeout=10
        )
        if login_response.status_code == 200:
            log(f"✅ Authenticated as {TEST_EMAIL}")
            authenticated = True
        else:
            log_warning(f"Could not authenticate with {TEST_EMAIL}, trying alternative credentials")
            # Try alternative credentials
            alt_creds = [
                {'email': 'test@test.com', 'password': 'test123'},
                {'email': 'admin@example.com', 'password': 'admin123'},
            ]
            for creds in alt_creds:
                login_response = session.post(
                    f"{BASE_URL}/api/login",
                    json=creds,
                    timeout=10
                )
                if login_response.status_code == 200:
                    log(f"✅ Authenticated as {creds['email']}")
                    authenticated = True
                    break
    except Exception as e:
        log_warning(f"Authentication attempt failed: {e}")
    
    if not authenticated:
        log_warning("⚠️  Could not authenticate - Journey API tests may fail with 401")
    
    results = {
        'accounts_tested': 0,
        'accounts_passed': 0,
        'accounts_failed': 0,
        'api_tests': []
    }
    
    # Test each account's journey endpoint
    for account in accounts[:10]:  # Test all accounts (up to 10)
        account_id = account['account_id']
        account_name = account.get('account_name', f'Account {account_id}')
        
        log(f"\nTesting journey API for account {account_id} ({account_name})...")
        
        api_test_result = {
            'account_id': account_id,
            'account_name': account_name,
            'tests': {}
        }
        
        try:
            # Test 1: Can we fetch journey data?
            url = f"{BASE_URL}/api/journey/{account_id}"
            log(f"  GET {url}")
            
            if authenticated:
                response = session.get(url, timeout=10)
            else:
                response = requests.get(url, timeout=10)
            api_test_result['status_code'] = response.status_code
            
            if response.status_code == 200:
                data = response.json()
                
                # Test 2: Does response have required structure?
                has_weekly_data = 'weekly_data' in data
                has_account_id = 'account_id' in data
                has_summary = 'summary' in data or 'journey_summary' in data
                
                api_test_result['tests']['has_weekly_data'] = has_weekly_data
                api_test_result['tests']['has_account_id'] = has_account_id
                api_test_result['tests']['has_summary'] = has_summary
                
                # Test 3: Is the account_id correct?
                returned_account_id = data.get('account_id')
                account_id_matches = str(returned_account_id) == str(account_id)
                api_test_result['tests']['account_id_matches'] = account_id_matches
                
                # Test 4: Do we have weekly data?
                weekly_data = data.get('weekly_data', [])
                has_weeks = len(weekly_data) > 0
                api_test_result['tests']['has_weeks'] = has_weeks
                api_test_result['weekly_data_count'] = len(weekly_data)
                
                # Overall validation
                all_passed = all([
                    has_weekly_data,
                    has_account_id,
                    has_summary,
                    account_id_matches,
                    has_weeks
                ])
                
                log_validation(
                    f"Journey API for Account {account_id}",
                    all_passed,
                    f"Journey API should return valid data structure for account {account_id}",
                    "Valid journey data with weekly_data, account_id, summary",
                    f"Status {response.status_code}, weekly_data={has_weekly_data}, weeks={len(weekly_data)}"
                )
                
                if all_passed:
                    log(f"    ✅ Journey API working perfectly for account {account_id}")
                    log(f"       - Account ID: {returned_account_id}")
                    log(f"       - Weeks of data: {len(weekly_data)}")
                    log(f"       - Starting health: {data.get('starting_health')}")
                    log(f"       - Ending health: {data.get('ending_health')}")
                    results['accounts_passed'] += 1
                    api_test_result['passed'] = True
                else:
                    log(f"    ❌ Journey API response incomplete for account {account_id}")
                    results['accounts_failed'] += 1
                    api_test_result['passed'] = False
            else:
                # Non-200 response
                log_validation(
                    f"Journey API for Account {account_id}",
                    False,
                    f"API returned status {response.status_code}",
                    "200",
                    str(response.status_code)
                )
                log(f"    ❌ Journey API failed for account {account_id}: HTTP {response.status_code}")
                log(f"       Response: {response.text[:200]}")
                results['accounts_failed'] += 1
                api_test_result['passed'] = False
                api_test_result['error'] = response.text[:200]
                
        except Exception as e:
            log_error(f"Journey API test failed for account {account_id}", e)
            results['accounts_failed'] += 1
            api_test_result['passed'] = False
            api_test_result['error'] = str(e)
        
        results['accounts_tested'] += 1
        results['api_tests'].append(api_test_result)
    
    # Test list accounts endpoint
    log(f"\nTesting journey API list accounts endpoint...")
    try:
        url = f"{BASE_URL}/api/journey/accounts"
        log(f"  GET {url}")
        
        if authenticated:
            response = session.get(url, timeout=10)
        else:
            response = requests.get(url, timeout=10)
        
        if response.status_code == 200:
            data = response.json()
            accounts_list = data.get('accounts', [])
            
            # Check if our customer's accounts are in the list
            our_account_ids = [a['account_id'] for a in accounts]
            found_accounts = [a for a in accounts_list if a['account_id'] in our_account_ids]
            
            log_validation(
                "Journey API List Accounts",
                len(found_accounts) > 0,
                f"Should list customer {customer_id}'s accounts",
                f"> 0 accounts",
                f"{len(found_accounts)} found out of {len(our_account_ids)} expected"
            )
            
            if len(found_accounts) > 0:
                log(f"    ✅ Found {len(found_accounts)} accounts in list:")
                for acc in found_accounts[:3]:
                    log(f"       - {acc['account_id']}: {acc.get('account_name', 'N/A')}")
        else:
            log_validation(
                "Journey API List Accounts",
                False,
                f"API returned status {response.status_code}",
                "200",
                str(response.status_code)
            )
            
    except Exception as e:
        log_error("Journey API list accounts test failed", e)
    
    # Store results
    test_results['journey_api_tests'] = results
    
    # Summary
    log(f"\n{'='*70}")
    log(f"JOURNEY API TEST SUMMARY")
    log(f"{'='*70}")
    log(f"  Accounts Tested: {results['accounts_tested']}")
    log(f"  Accounts Passed: {results['accounts_passed']} ✅")
    log(f"  Accounts Failed: {results['accounts_failed']} ❌")
    log(f"  Success Rate: {(results['accounts_passed'] / results['accounts_tested'] * 100) if results['accounts_tested'] > 0 else 0:.1f}%")
    log(f"{'='*70}")
    
    return results

# ============================================================================
# Report Generation
# ============================================================================

def generate_report():
    """Generate final test report"""
    test_results["summary"]["end_time"] = datetime.now().isoformat()
    
    # Calculate success rate
    total = test_results["summary"]["total_steps"] + test_results["summary"]["total_validations"]
    passed = test_results["summary"]["passed_steps"] + test_results["summary"]["passed_validations"]
    success_rate = (passed / total * 100) if total > 0 else 0
    
    test_results["summary"]["success_rate"] = f"{success_rate:.2f}%"
    
    # Save JSON report
    if REPORT_FILE:
        with open(REPORT_FILE, 'w', encoding='utf-8') as f:
            json.dump(test_results, f, indent=2, default=str, ensure_ascii=False)
        log(f"\n✅ Report saved to: {REPORT_FILE}")
    
    # Print summary
    log("\n" + "=" * 70)
    log("TEST SUMMARY")
    log("=" * 70)
    log(f"Test Name: {test_results['test_name']}")
    log(f"Version: {test_results.get('version', 'N/A')}")
    log(f"Duration: {test_results['summary'].get('end_time', 'N/A')}")
    log("")
    log(f"Steps:       {test_results['summary']['passed_steps']}/{test_results['summary']['total_steps']} passed")
    log(f"Validations: {test_results['summary']['passed_validations']}/{test_results['summary']['total_validations']} passed")
    log(f"Success Rate: {test_results['summary']['success_rate']}")
    log("")
    
    # Journey API summary
    if 'journey_api_tests' in test_results and test_results['journey_api_tests']:
        journey_results = test_results['journey_api_tests']
        log(f"Journey API Tests:")
        log(f"  Accounts Tested: {journey_results['accounts_tested']}")
        log(f"  Accounts Passed: {journey_results['accounts_passed']} ✅")
        log(f"  Accounts Failed: {journey_results['accounts_failed']} ❌")
    
    if test_results["errors"]:
        log(f"\nErrors: {len(test_results['errors'])}")
        for error in test_results["errors"]:
            log(f"  - {error['message']}", "ERROR")
    
    if test_results["warnings"]:
        log(f"\nWarnings: {len(test_results['warnings'])}")
        for warning in test_results["warnings"]:
            log(f"  - {warning}", "WARNING")
    
    log("=" * 70)

# ============================================================================
# Main Test Execution
# ============================================================================

def main():
    """Main test execution"""
    log("=" * 70)
    log("COMPLETE END-TO-END ONBOARDING TEST V2")
    log("WITH JOURNEY API VALIDATION")
    log("=" * 70)
    log(f"Started at: {datetime.now().isoformat()}")
    log(f"Log file: {LOG_FILE}")
    log(f"Base URL: {BASE_URL}")
    log("")
    log("NEW IN V2:")
    log("  ✨ Step 6: Journey API endpoint validation")
    log("  ✨ Dynamic customer ID (no hardcoding)")
    log("  ✨ Server health check")
    log("  ✨ Enhanced validation coverage")
    log("=" * 70)
    log("")
    
    # NEW: Verify server is running
    if not verify_server_running():
        log("❌ Test cannot proceed without server running", "ERROR")
        log("   Please start the Flask app and try again:", "ERROR")
        log("   → python3 app_v3_minimal.py", "ERROR")
        return 1
    
    customer_id = None
    customer_dir = None
    generated_data = None
    
    try:
        # Step 1: Complete onboarding (create customer via API)
        customer_id = test_complete_onboarding()
        log(f"\n✅ Customer {customer_id} created")
        
        # Step 2: Provision directory (via API)
        customer_dir = test_provision_directory(customer_id)
        
        # Step 3: Generate and upload files
        generated_data = test_generate_and_upload_files(customer_id, customer_dir)
        
        # Step 4: Process data (load + embeddings + wizard A via API)
        execution_state = test_process_data_api(customer_id, customer_dir)
        
        # Step 5: Validate final state
        test_validate_final_state(customer_id, customer_dir)
        
        # NEW: Step 6 - Validate Journey API
        accounts = generated_data.get('accounts', [])
        api_results = test_validate_journey_api(customer_id, accounts)
        
        # Final summary
        log("\n" + "=" * 70)
        log("✅ TEST COMPLETED SUCCESSFULLY!")
        log("=" * 70)
        log(f"Customer ID: {customer_id}")
        log(f"Company: {TEST_COMPANY_NAME}")
        log(f"Email: {TEST_EMAIL}")
        log("")
        log("What was tested:")
        log("  ✅ Customer creation via API")
        log("  ✅ Directory provisioning")
        log("  ✅ Data generation and upload")
        log("  ✅ Data loading to PostgreSQL")
        log("  ✅ Embeddings creation in Qdrant")
        log("  ✅ Wizard A journey generation")
        log("  ✅ Database validations")
        log("  ✅ NEW: Journey API endpoint validation")
        log("")
        log(f"Journey API Results:")
        log(f"  - Tested {api_results['accounts_tested']} accounts")
        log(f"  - Passed {api_results['accounts_passed']} ✅")
        log(f"  - Failed {api_results['accounts_failed']} ❌")
        log("")
        log(f"You can now:")
        log(f"  1. Login to the portal with customer {customer_id}")
        log(f"  2. Access journey data via API: {BASE_URL}/api/journey/{{account_id}}")
        log(f"  3. View test report: {REPORT_FILE}")
        log("=" * 70)
        
    except Exception as e:
        log_error("Test execution failed", e)
        if customer_id:
            log(f"\n⚠️  Customer {customer_id} was created but test failed", "WARNING")
            log(f"   You may need to clean up customer {customer_id} manually", "WARNING")
    
    finally:
        generate_report()
        
        # Return exit code
        if test_results["summary"]["failed_steps"] > 0 or test_results["summary"]["failed_validations"] > 0:
            return 1
        return 0

if __name__ == "__main__":
    sys.exit(main())
