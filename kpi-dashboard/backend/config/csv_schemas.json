          "pillar",
          "unit",
          "p25",
          "p50",
          "p75",
          "p90"
        ],
        "optional_columns": [
          "pillar_name",
          "source",
          "methodology",
          "last_updated",
          "curated"
        ],
        "db_table": "context_nodes (node_type=EXTERNAL_CONTEXT)",
        "platform_curated": true,
        "seed_file": "config/industry_benchmarks/{vertical}.csv",
        "source": "LLM-seeded from industry research (Uptime Institute, ITIC, Gartner, MLPerf, etc.), then curated by domain experts. curated=true means expert-reviewed."
