{
  "_description": "Single source of truth for CSV column definitions. Both backend generate_synthetic_customer_data.py and load-driver csv_generator.py MUST use these exact column names. The onboarding API (onboarding_api_v2_config_aware.py) validates against these.",
  "_version": "2.0",
  "_updated": "2026-03-15",
  "_consolidation_note": "Consolidated from 15 to 11 files. Customers provide 8 files; platform auto-generates 2 (decisions, signal_edges) and seeds 1 curated file (industry_benchmarks from config/industry_benchmarks/{vertical}.csv).",
  "regular_model": {
    "_description": "4 CSVs that every customer provides (with or without context graph).",
    "files": {
      "accounts.csv": {
        "required_columns": [
          "source_account_id",
          "customer_id",
          "account_name",
          "industry",
          "region"
        ],
        "optional_columns": [
          "vertical",
          "tier",
          "arr",
          "revenue",
          "contract_start",
          "contract_end",
          "renewal_date",
          "csm_name",
          "csm_email",
          "account_status",
          "uuid"
        ],
        "db_table": "accounts"
      },
      "kpi_measurements.csv": {
        "required_columns": [
          "source_account_id",
          "kpi_code",
          "measured_at",
          "value"
        ],
        "optional_columns": [
          "kpi_name",
          "pillar",
          "target",
          "weight",
          "unit",
          "status"
        ],
        "db_table": "dc2s_kpis",
        "note": "NEVER use kpi_data.csv \u2014 always kpi_measurements.csv"
      },
      "enhanced_qualitative_signals.csv": {
        "required_columns": [
          "source_account_id",
          "signal_date",
          "signal_type",
          "content",
          "sentiment"
        ],
        "optional_columns": [
          "signal_ref",
          "sentiment_score",
          "stakeholder_name",
          "stakeholder_title",
          "causal_chain_ref",
          "revenue_impact",
          "confidence",
          "source_platform"
        ],
        "db_table": "qualitative_signals + context_nodes (node_type=SIGNAL)",
        "note": "Replaces old qualitative_signals.csv. Graph metadata columns are optional \u2014 ignored when context graph is OFF."
      },
      "products.csv": {
        "required_columns": [
          "source_account_id",
          "product_name"
        ],
        "optional_columns": [
          "product_category",
          "quantity",
          "unit_price",
          "deployment_date",
          "status",
          "customer_id"
        ],
        "db_table": "products"
      }
    }
  },
  "context_graph_model": {
    "_description": "7 CSVs for context graph mode. 4 customer-provided + 3 auto-generated by platform.",
    "customer_provided": {
      "stakeholders.csv": {
        "required_columns": [
          "source_account_id",
          "stakeholder_name",
          "title",
          "role",
          "influence_score"
        ],
        "optional_columns": [
          "email",
          "engagement_frequency",
          "sentiment",
          "department",
          "is_active",
          "source_platform",
          "first_observed_at"
        ],
        "db_table": "context_nodes (node_type=STAKEHOLDER)"
      },
      "engagement_events.csv": {
        "required_columns": [
          "source_account_id",
          "event_date",
          "event_type",
          "description"
        ],
        "optional_columns": [
          "stakeholder_name",
          "sentiment_shift",
          "channel",
          "duration_minutes",
          "outcome",
          "source_platform"
        ],
        "db_table": "context_nodes (node_type=SIGNAL, subtype=engagement)"
      },
      "account_business_profiles.csv": {
        "required_columns": [
          "source_account_id",
          "arr",
          "industry",
          "employee_count"
        ],
        "optional_columns": [
          "fiscal_year_end",
          "tech_stack",
          "cloud_provider",
          "competitive_landscape",
          "strategic_initiatives",
          "budget_cycle",
          "profile_date",
          "assigned_csm",
          "csm_manager",
          "executive_sponsor",
          "mrr",
          "primary_champion_name",
          "primary_champion_title",
          "primary_champion_email",
          "primary_champion_engagement_score",
          "last_updated"
        ],
        "db_table": "context_nodes (node_type=ACCOUNT) + accounts (profile_metadata JSON)",
        "note": "Merged with old profiles.csv \u2014 CSM/champion fields are now optional columns here."
      },
      "outcomes.csv": {
        "required_columns": [
          "source_account_id",
          "outcome_date",
          "title",
          "outcome_type",
          "revenue_value"
        ],
        "optional_columns": [
          "outcome_id",
          "evidence",
          "confidence",
          "related_decision_id",
          "source_platform"
        ],
        "db_table": "context_nodes (node_type=OUTCOME)"
      }
    },
    "auto_generated": {
      "_description": "These 2 files are derived by the platform during process-data. If a customer uploads them, the upload is accepted and auto-generation is skipped.",
      "decisions.csv": {
        "required_columns": [
          "source_account_id",
          "decision_date",
          "title",
          "decision_maker_role",
          "chosen_option"
        ],
        "optional_columns": [
          "decision_id",
          "options_considered",
          "revenue_impact",
          "risk_level",
          "evidence_refs",
          "outcome_description",
          "confidence"
        ],
        "db_table": "context_nodes (node_type=DECISION)",
        "auto_generated": true,
        "source": "Inferred from story arc patterns + outcome/stakeholder data"
      },
      "signal_edges.csv": {
        "required_columns": [
          "from_signal_ref",
          "to_signal_ref",
          "edge_type",
          "weight"
        ],
        "optional_columns": [
          "confidence",
          "lag_days",
          "revenue_impact",
          "evidence",
          "source_platform",
          "created_by",
          "evidence_type",
          "evidence_description",
          "kpi_code",
          "kpi_value",
          "decision_ref"
        ],
        "db_table": "context_edges",
        "auto_generated": true,
        "source": "Derived from temporal correlation between signals + story arc causal chains. Also includes SOURCED_FROM edges (merged from old decision_evidence.csv)."
      }
    },
    "platform_curated": {
      "_description": "Seeded from config/industry_benchmarks/{vertical}.csv. LLM-generated initial data, curated by domain experts. Customer can override by uploading their own.",
