#!/usr/bin/env python3
"""
Database Schema Initialization
===============================

Creates all required PostgreSQL tables for CS Pulse import system.

Tables:
- kpi_reference_ranges: Industry-standard KPI ranges and formulas
- customer_imports: Import job tracking
- customer_kpi_coverage: Which KPIs each customer tracks
- nps_csat_surveys: Customer satisfaction data
- portfolio_metrics: Aggregated portfolio metrics

Usage:
    python init_database_schema.py --conn postgresql://user:pass@localhost/cs_pulse
"""

import argparse
import psycopg2
from psycopg2 import sql


# SQL for creating tables
CREATE_TABLES_SQL = """
-- ============================================================================
-- KPI REFERENCE RANGES
-- ============================================================================
-- Stores industry-standard ranges and normalization formulas for all KPIs

CREATE TABLE IF NOT EXISTS kpi_reference_ranges (
    kpi_name VARCHAR(100) PRIMARY KEY,
    pillar VARCHAR(10) NOT NULL,
    unit VARCHAR(50) NOT NULL,
    critical_range VARCHAR(50) NOT NULL,
    at_risk_range VARCHAR(50) NOT NULL,
    healthy_range VARCHAR(50) NOT NULL,
    normalization_formula TEXT NOT NULL,
    is_inverted BOOLEAN DEFAULT FALSE,
    description TEXT,
    created_at TIMESTAMP DEFAULT NOW(),
    updated_at TIMESTAMP DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_kpi_pillar ON kpi_reference_ranges(pillar);

-- ============================================================================
-- CUSTOMER IMPORTS
-- ============================================================================
-- Tracks import jobs and their status

CREATE TABLE IF NOT EXISTS customer_imports (
    import_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    file_name VARCHAR(255) NOT NULL,
    status VARCHAR(20) NOT NULL DEFAULT 'pending',
    customers_imported INT DEFAULT 0,
    weeks_imported INT DEFAULT 0,
    started_at TIMESTAMP DEFAULT NOW(),
    completed_at TIMESTAMP,
    errors JSONB,
    warnings JSONB,
    import_metadata JSONB,
    created_by VARCHAR(100),
    CONSTRAINT valid_status CHECK (status IN ('pending', 'processing', 'completed', 'failed', 'cancelled'))
);

CREATE INDEX IF NOT EXISTS idx_import_status ON customer_imports(status);
CREATE INDEX IF NOT EXISTS idx_import_started ON customer_imports(started_at DESC);

-- ============================================================================
-- CUSTOMER KPI COVERAGE
-- ============================================================================
-- Tracks which KPIs each customer monitors

CREATE TABLE IF NOT EXISTS customer_kpi_coverage (
    account_id VARCHAR(50) NOT NULL,
    kpi_name VARCHAR(100) NOT NULL,
    is_tracked BOOLEAN DEFAULT TRUE,
    last_value FLOAT,
    last_raw_value TEXT,
    last_raw_unit VARCHAR(50),
    last_updated TIMESTAMP DEFAULT NOW(),
    import_id UUID REFERENCES customer_imports(import_id),
    PRIMARY KEY (account_id, kpi_name),
    FOREIGN KEY (kpi_name) REFERENCES kpi_reference_ranges(kpi_name)
);

CREATE INDEX IF NOT EXISTS idx_coverage_account ON customer_kpi_coverage(account_id);
CREATE INDEX IF NOT EXISTS idx_coverage_tracked ON customer_kpi_coverage(is_tracked) WHERE is_tracked = TRUE;
CREATE INDEX IF NOT EXISTS idx_coverage_updated ON customer_kpi_coverage(last_updated DESC);

-- ============================================================================
-- NPS & CSAT SURVEYS
-- ============================================================================
-- Customer satisfaction survey data

CREATE TABLE IF NOT EXISTS nps_csat_surveys (
    survey_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    account_id VARCHAR(50) NOT NULL,
    survey_type VARCHAR(10) NOT NULL,
    score INT NOT NULL,
    survey_date DATE NOT NULL,
    comments TEXT,
    respondent_role VARCHAR(100),
    import_id UUID REFERENCES customer_imports(import_id),
    created_at TIMESTAMP DEFAULT NOW(),
    CONSTRAINT valid_survey_type CHECK (survey_type IN ('NPS', 'CSAT')),
    CONSTRAINT valid_nps_score CHECK (survey_type != 'NPS' OR (score >= -100 AND score <= 100)),
    CONSTRAINT valid_csat_score CHECK (survey_type != 'CSAT' OR (score >= 1 AND score <= 5))
);

CREATE INDEX IF NOT EXISTS idx_survey_account ON nps_csat_surveys(account_id);
CREATE INDEX IF NOT EXISTS idx_survey_date ON nps_csat_surveys(survey_date DESC);
CREATE INDEX IF NOT EXISTS idx_survey_type ON nps_csat_surveys(survey_type);

-- ============================================================================
-- PORTFOLIO METRICS
-- ============================================================================
-- Aggregated portfolio-level metrics calculated daily

CREATE TABLE IF NOT EXISTS portfolio_metrics (
    metric_date DATE PRIMARY KEY,
    total_customers INT NOT NULL DEFAULT 0,
    avg_health_score FLOAT,
    avg_coverage_pct FLOAT,
    avg_data_quality FLOAT,
    crisis_customers INT DEFAULT 0,
    at_risk_customers INT DEFAULT 0,
    healthy_customers INT DEFAULT 0,
    total_weeks_tracked INT DEFAULT 0,
    total_kpi_records INT DEFAULT 0,
    calculated_at TIMESTAMP DEFAULT NOW(),
    calculation_metadata JSONB
);

CREATE INDEX IF NOT EXISTS idx_portfolio_date ON portfolio_metrics(metric_date DESC);

-- ============================================================================
-- IMPORT PROGRESS (for real-time tracking)
-- ============================================================================

CREATE TABLE IF NOT EXISTS import_progress (
    import_id UUID PRIMARY KEY REFERENCES customer_imports(import_id),
    current_customer VARCHAR(50),
    current_week INT,
    total_customers INT NOT NULL,
    processed_customers INT DEFAULT 0,
    total_weeks INT NOT NULL,
    processed_weeks INT DEFAULT 0,
    progress_pct FLOAT DEFAULT 0,
    status VARCHAR(20) DEFAULT 'processing',
    current_operation VARCHAR(100),
    errors TEXT[],
    warnings TEXT[],
    updated_at TIMESTAMP DEFAULT NOW()
);

CREATE INDEX IF NOT EXISTS idx_progress_status ON import_progress(status);

-- ============================================================================
-- DC2_S JOURNEY TABLES (Customer 9 - DC2_S Vertical)
-- ============================================================================

-- Weekly journey snapshots
CREATE TABLE IF NOT EXISTS dc2s_journey_weeks (
    week_id SERIAL PRIMARY KEY,
    account_id VARCHAR(50) NOT NULL,
    customer_id INT NOT NULL DEFAULT 9,
    week_number INT NOT NULL,
    week_start_date DATE NOT NULL,
    health_score FLOAT,
    pillar_scores JSONB,
    kpi_values JSONB,
    raw_kpi_values JSONB,
    events_summary JSONB,
    sentiment_score FLOAT,
    csm_investment_hours FLOAT,
    data_quality FLOAT,
    phase VARCHAR(20),
    created_at TIMESTAMP DEFAULT NOW(),
    updated_at TIMESTAMP DEFAULT NOW(),
    UNIQUE(account_id, week_number),
    CONSTRAINT valid_customer CHECK (CUSTOMER_ID = 11),
    CONSTRAINT valid_phase CHECK (phase IN ('healthy', 'at_risk', 'crisis', 'recovery', 'moderate', 'growth', 'churned') OR phase IS NULL)
);

CREATE INDEX IF NOT EXISTS idx_dc2s_weeks_account ON dc2s_journey_weeks(account_id);
CREATE INDEX IF NOT EXISTS idx_dc2s_weeks_customer ON dc2s_journey_weeks(customer_id);
CREATE INDEX IF NOT EXISTS idx_dc2s_weeks_week ON dc2s_journey_weeks(week_number);
CREATE INDEX IF NOT EXISTS idx_dc2s_weeks_date ON dc2s_journey_weeks(week_start_date);

-- Journey events (qualitative signals)
CREATE TABLE IF NOT EXISTS dc2s_journey_events (
    event_id SERIAL PRIMARY KEY,
    account_id VARCHAR(50) NOT NULL,
    customer_id INT NOT NULL DEFAULT 9,
    week_number INT,
    event_type VARCHAR(50) NOT NULL,
    event_date DATE,
    description TEXT,
    sentiment VARCHAR(20),
    sentiment_value FLOAT,
    csm_action JSONB,
    outcome TEXT,
    kpi_impacts JSONB,
    created_at TIMESTAMP DEFAULT NOW(),
    CONSTRAINT valid_customer_evt CHECK (CUSTOMER_ID = 11),
    CONSTRAINT valid_sentiment CHECK (sentiment IN ('positive', 'neutral', 'negative') OR sentiment IS NULL)
);

CREATE INDEX IF NOT EXISTS idx_dc2s_events_account ON dc2s_journey_events(account_id);
CREATE INDEX IF NOT EXISTS idx_dc2s_events_customer ON dc2s_journey_events(customer_id);
CREATE INDEX IF NOT EXISTS idx_dc2s_events_type ON dc2s_journey_events(event_type);
CREATE INDEX IF NOT EXISTS idx_dc2s_events_date ON dc2s_journey_events(event_date);

-- Milestones (training labels)
CREATE TABLE IF NOT EXISTS dc2s_milestones (
    milestone_id SERIAL PRIMARY KEY,
    account_id VARCHAR(50) NOT NULL,
    customer_id INT NOT NULL DEFAULT 9,
    milestone_type VARCHAR(50) NOT NULL,
    milestone_date DATE NOT NULL,
    week_number INT,
    label VARCHAR(50),
    metadata JSONB,
    created_at TIMESTAMP DEFAULT NOW(),
    CONSTRAINT valid_customer_mil CHECK (CUSTOMER_ID = 11)
);

CREATE INDEX IF NOT EXISTS idx_dc2s_milestones_account ON dc2s_milestones(account_id);
CREATE INDEX IF NOT EXISTS idx_dc2s_milestones_customer ON dc2s_milestones(customer_id);
CREATE INDEX IF NOT EXISTS idx_dc2s_milestones_type ON dc2s_milestones(milestone_type);

-- Predictions (Signal Analyst outputs)
CREATE TABLE IF NOT EXISTS dc2s_predictions (
    prediction_id SERIAL PRIMARY KEY,
    account_id VARCHAR(50) NOT NULL,
    customer_id INT NOT NULL DEFAULT 9,
    prediction_date DATE NOT NULL,
    week_number INT,
    predicted_phase VARCHAR(20),
    confidence_score FLOAT,
    prediction_horizon_weeks INT,
    feature_vector JSONB,
    model_version VARCHAR(50),
    created_at TIMESTAMP DEFAULT NOW(),
    CONSTRAINT valid_customer_pred CHECK (CUSTOMER_ID = 11),
    CONSTRAINT valid_predicted_phase CHECK (predicted_phase IN ('healthy', 'at_risk', 'crisis', 'recovery', 'moderate', 'growth', 'churned') OR predicted_phase IS NULL)
);

CREATE INDEX IF NOT EXISTS idx_dc2s_predictions_account ON dc2s_predictions(account_id);
CREATE INDEX IF NOT EXISTS idx_dc2s_predictions_customer ON dc2s_predictions(customer_id);
CREATE INDEX IF NOT EXISTS idx_dc2s_predictions_date ON dc2s_predictions(prediction_date);

-- Actions (CSM actions taken)
CREATE TABLE IF NOT EXISTS dc2s_actions (
    action_id SERIAL PRIMARY KEY,
    account_id VARCHAR(50) NOT NULL,
    customer_id INT NOT NULL DEFAULT 9,
    action_date DATE NOT NULL,
    week_number INT,
    action_type VARCHAR(50) NOT NULL,
    description TEXT,
    csm_id VARCHAR(100),
    outcome TEXT,
    metadata JSONB,
    created_at TIMESTAMP DEFAULT NOW(),
    CONSTRAINT valid_customer_act CHECK (CUSTOMER_ID = 11)
);

CREATE INDEX IF NOT EXISTS idx_dc2s_actions_account ON dc2s_actions(account_id);
CREATE INDEX IF NOT EXISTS idx_dc2s_actions_customer ON dc2s_actions(customer_id);
CREATE INDEX IF NOT EXISTS idx_dc2s_actions_type ON dc2s_actions(action_type);
CREATE INDEX IF NOT EXISTS idx_dc2s_actions_date ON dc2s_actions(action_date);
""".strip()


# SQL for populating KPI reference ranges
POPULATE_KPI_RANGES_SQL = """
-- ============================================================================
-- POPULATE KPI REFERENCE RANGES
-- ============================================================================

INSERT INTO kpi_reference_ranges (kpi_name, pillar, unit, critical_range, at_risk_range, healthy_range, normalization_formula, is_inverted, description)
VALUES
    -- P1: Deployment Velocity
    ('deployment_success_rate', 'P1', '%', '<50%', '50-70%', '>70%', 'value', FALSE, 'Percentage of successful deployments'),
    ('time_to_first_cluster', 'P1', 'hours', '>48h', '24-48h', '<24h', '100 - (hours/0.48)', TRUE, 'Time to deploy first cluster'),
    ('api_adoption_rate', 'P1', '%', '<40%', '40-60%', '>60%', 'value', FALSE, 'API integration adoption'),
    ('automation_integration_level', 'P1', '%', '<40%', '40-60%', '>60%', 'value', FALSE, 'Automation integration level'),
    ('technical_readiness_score', 'P1', 'days', '>30d', '15-30d', '<15d', '100 - (days/0.3)', TRUE, 'Technical readiness timeline'),
    ('customer_training_completion', 'P1', '%', '<40%', '40-60%', '>60%', 'value', FALSE, 'Training completion rate'),
    ('infra_provisioning_velocity', 'P1', 'GPUs/day', '<100', '100-150', '>150', 'GPUs/1.5', FALSE, 'Infrastructure provisioning speed'),
    
    -- P2: Operational Stability
    ('rma_frequency_rate', 'P2', 'RMAs/1000 GPU-hrs', '>0.5', '0.3-0.5', '<0.3', '100 - (RMAs*200)', TRUE, 'Return merchandise rate'),
    ('mtbf', 'P2', 'hours', '<5000h', '5000-10000h', '>10000h', 'hours/100', FALSE, 'Mean time between failures'),
    ('critical_incident_rate', 'P2', 'P1 incidents/month', '>2', '1-2', '<1', '100 - (incidents*25)', TRUE, 'Critical incident frequency'),
    ('unplanned_downtime', 'P2', '% uptime', '<99.5%', '99.5-99.9%', '>99.9%', '(uptime%-98)*50', FALSE, 'System uptime percentage'),
    ('support_ticket_velocity', 'P2', 'hours', '>48h', '24-48h', '<24h', '100 - (hours/0.48)', TRUE, 'Ticket resolution time'),
    ('thermal_power_alerts', 'P2', 'alerts/week', '>5', '2-5', '<2', '100 - (alerts*10)', TRUE, 'Thermal/power alerts'),
    ('firmware_stability', 'P2', '%', '<70%', '70-90%', '>90%', 'value', FALSE, 'Firmware stability score'),
    
    -- P3: AI Workload Performance
    ('gpu_utilization_rate', 'P3', '%', '<50%', '50-70%', '>70%', 'value', FALSE, 'GPU utilization'),
    ('training_job_completion', 'P3', '%', '<60%', '60-75%', '>75%', 'value', FALSE, 'Training job success rate'),
    ('model_deployment_success', 'P3', '%', '<60%', '60-75%', '>75%', 'value', FALSE, 'Model deployment success'),
    ('workload_scaling_success', 'P3', '%', '<60%', '60-75%', '>75%', 'value', FALSE, 'Workload scaling success'),
    ('inference_performance', 'P3', 'ms latency', '>200', '100-200', '<100', '100 - (ms/2)', TRUE, 'Inference latency'),
    ('data_pipeline_efficiency', 'P3', '%', '<60%', '60-75%', '>75%', 'value', FALSE, 'Data pipeline efficiency'),
    ('multi_node_scaling', 'P3', '%', '<60%', '60-75%', '>75%', 'value', FALSE, 'Multi-node scaling efficiency'),
    
    -- P4: Channel Partner Health
    ('partner_engagement_score', 'P4', 'meetings/month', '<1', '1-2', '>2', 'meetings*25', FALSE, 'Partner engagement frequency'),
    ('cosell_activity', 'P4', 'deals/quarter', '<2', '2-4', '>4', 'deals*12.5', FALSE, 'Co-sell deal activity'),
    ('partner_satisfaction', 'P4', 'NPS', '<30', '30-50', '>50', '(NPS+100)/2', FALSE, 'Partner NPS score'),
    ('joint_marketing', 'P4', 'campaigns/quarter', '<1', '1-2', '>2', 'campaigns*25', FALSE, 'Joint marketing campaigns'),
    ('partner_certification', 'P4', '%', '<40%', '40-60%', '>60%', 'value', FALSE, 'Partner certification rate'),
    ('deal_registration_velocity', 'P4', 'days', '>14d', '7-14d', '<7d', '100 - (days/0.14)', TRUE, 'Deal registration speed'),
    ('joint_roadmap_alignment', 'P4', '%', '<40%', '40-60%', '>60%', 'value', FALSE, 'Roadmap alignment score'),
    
    -- P5: Expansion Readiness
    ('expansion_probability_90d', 'P5', '%', '<40%', '40-60%', '>60%', 'value', FALSE, '90-day expansion probability'),
    ('capacity_utilization_trajectory', 'P5', '% growth MoM', '<5%', '5-10%', '>10%', 'growth*6', FALSE, 'Capacity growth rate'),
    ('workload_growth_velocity', 'P5', '% growth', '<5%', '5-10%', '>10%', 'growth*6', FALSE, 'Workload growth rate'),
    ('decision_maker_engagement', 'P5', 'meetings/quarter', '<1', '1-2', '>2', 'meetings*25', FALSE, 'Executive engagement'),
    ('budget_planning_visibility', 'P5', '%', '<40%', '40-60%', '>60%', 'value', FALSE, 'Budget visibility'),
    ('competitive_displacement_risk', 'P5', '%', '>60%', '40-60%', '<40%', '100 - value', TRUE, 'Competitive risk'),
    ('use_case_expansion', 'P5', 'new use cases/quarter', '<1', '1-2', '>2', 'cases*25', FALSE, 'Use case expansion rate')
ON CONFLICT (kpi_name) DO NOTHING;
""".strip()


def create_database_schema(conn_string: str, populate_kpis: bool = True):
    """Create all database tables"""
    
    print("="*70)
    print("DATABASE SCHEMA INITIALIZATION")
    print("="*70)
    print()
    
    try:
        # Connect to database
        print("🔌 Connecting to database...")
        conn = psycopg2.connect(conn_string)
        conn.autocommit = True
        cursor = conn.cursor()
        print("   ✅ Connected successfully")
        print()
        
        # Create tables
        print("📋 Creating tables...")
        cursor.execute(CREATE_TABLES_SQL)
        print("   ✅ All tables created")
        print()
        
        # Populate KPI ranges
        if populate_kpis:
            print("📊 Populating KPI reference ranges...")
            cursor.execute(POPULATE_KPI_RANGES_SQL)
            cursor.execute("SELECT COUNT(*) FROM kpi_reference_ranges")
            count = cursor.fetchone()[0]
            print(f"   ✅ Populated {count} KPI reference ranges")
            print()
        
        # Verify tables
        print("🔍 Verifying tables...")
        cursor.execute("""
            SELECT table_name 
            FROM information_schema.tables 
            WHERE table_schema = 'public' 
            AND table_name IN (
                'kpi_reference_ranges',
                'customer_imports',
                'customer_kpi_coverage',
                'nps_csat_surveys',
                'portfolio_metrics',
                'import_progress',
                'dc2s_journey_weeks',
                'dc2s_journey_events',
                'dc2s_milestones',
                'dc2s_predictions',
                'dc2s_actions'
            )
            ORDER BY table_name
        """)
        
        tables = cursor.fetchall()
        expected_tables = [
            'customer_imports',
            'customer_kpi_coverage',
            'import_progress',
            'kpi_reference_ranges',
            'nps_csat_surveys',
            'portfolio_metrics',
            'dc2s_journey_weeks',
            'dc2s_journey_events',
            'dc2s_milestones',
            'dc2s_predictions',
            'dc2s_actions'
        ]
        
        for table in expected_tables:
            if any(t[0] == table for t in tables):
                # Get row count
                cursor.execute(sql.SQL("SELECT COUNT(*) FROM {}").format(sql.Identifier(table)))
                count = cursor.fetchone()[0]
                print(f"   ✅ {table}: {count} rows")
            else:
                print(f"   ❌ {table}: NOT FOUND")
        
        print()
        print("="*70)
        print("✅ SCHEMA INITIALIZATION COMPLETE!")
        print("="*70)
        print()
        print("Next steps:")
        print("1. Initialize Qdrant collections: python init_qdrant_collections.py")
        print("2. Start importing data: python import_integration_adapter.py")
        print()
        
        cursor.close()
        conn.close()
        
        return True
        
    except Exception as e:
        print(f"\n❌ Schema creation failed: {e}")
        print("\nTroubleshooting:")
        print("1. Check database connection string")
        print("2. Verify PostgreSQL is running")
        print("3. Check user has CREATE TABLE permissions")
        return False


def main():
    """Main function"""
    
    import os
    from dotenv import load_dotenv
    
    # Load environment variables
    env_path = os.path.join(os.path.dirname(__file__), '../../../../.env')
    if os.path.exists(env_path):
        load_dotenv(env_path)
    
    parser = argparse.ArgumentParser(description='Initialize CS Pulse database schema')
    parser.add_argument(
        '--conn',
        default=os.getenv('DATABASE_URL', 'postgresql://postgres:postgres@localhost/cs_pulse'),
        help='PostgreSQL connection string (defaults to DATABASE_URL env var)'
    )
    parser.add_argument(
        '--skip-kpis',
        action='store_true',
        help='Skip populating KPI reference ranges'
    )
    
    args = parser.parse_args()
    
    success = create_database_schema(args.conn, populate_kpis=not args.skip_kpis)
    
    return 0 if success else 1


if __name__ == '__main__':
    exit(main())
